# RepoLens Environment Variables

# Backend API endpoint (Cloud Run production or local http://localhost:8080)
# Both VITE_API_BASE_URL and NEXT_PUBLIC_API_BASE_URL are supported
VITE_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Gemini API Key for AI Architecture Diagram Synthesis and Chat Copilot
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token to avoid GitHub API 60 req/hr anonymous rate limits
GITHUB_TOKEN=your_github_personal_access_token_here

# Firebase OAuth credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
